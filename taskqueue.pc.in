prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@/taskqueue

Name: taskqueue
Description: TaskQueue library for loading tasks into pre/middle/post worker queues
Version: @PROJECT_VERSION@
Libs: -L${libdir} -ltaskqueue
Cflags: -I${includedir}
